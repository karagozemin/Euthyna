# Public Arc deployment configuration (review before every mainnet deployment)
ARC_ENVIRONMENT=testnet
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_EXPLORER_URL=https://explorer.testnet.arc.io
ARC_VERIFIER_URL=https://explorer.testnet.arc.io/api/
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_USDC_ERC20_DECIMALS=6
ARC_NATIVE_GAS_DECIMALS=18
OBLIGATION_VAULT_ADDRESS=
OBLIGATION_VAULT_DEPLOYMENT_BLOCK=
VAULT_BUSINESS_ID=                 # public tenant identifier used to derive VAULT_BUSINESS_ID_HASH
VAULT_BUSINESS_ID_HASH=            # keccak256(UTF-8 VAULT_BUSINESS_ID)
VAULT_OWNER_ADDRESS=
VAULT_PER_PAYMENT_CAP_MINOR=1000000
VAULT_APPROVAL_THRESHOLD_MINOR=500000
VAULT_INITIAL_FUNDING_MINOR=1000000
VAULT_POLICY_VERSION=1
VAULT_WITNESS_VERSION=1
VAULT_RULES_VERSION=1

# Circle developer-controlled wallet. Never expose these to a model or browser.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=

# Rotatable witness signer. Use managed key custody outside local development.
WITNESS_SIGNER_KEY_VERSION=
WITNESS_SIGNER_ADDRESS=

# Deployment/test runner only. Never commit or expose either private key.
ARC_DEPLOYER_PRIVATE_KEY=
WITNESS_SIGNER_PRIVATE_KEY=
TEST_VENDOR_ID=vendor_arc_test
TEST_VENDOR_ID_HASH=              # keccak256(UTF-8 TEST_VENDOR_ID)
TEST_VENDOR_PAYEE_ADDRESS=
SETTLEMENT_AMOUNT_MINOR=1000      # 0.001 USDC at 6 ERC-20 decimals
TEST_OBLIGATION_ID=obl_arc_test_001
TEST_OPERATION_ID=op_arc_test_001_release_1
TEST_RUN_CREATED_AT=              # fixed ISO-8601 value; reuse exactly after crash
TEST_VALID_UNTIL_UNIX=            # future Unix seconds; reuse exactly after crash

# Explicit operator acknowledgements for commands that broadcast transactions.
ARC_SMOKE_BROADCAST=NO
ARC_TESTNET_SETTLEMENT_ACK=NO
ALLOW_TESTNET_RAW_WITNESS_KEY=NO
FIRST_ARC_CRASH_AFTER_BROADCAST=NO
VERIFY_CONTRACT=YES
