{
  "name": "euthyna",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build && forge build --root contracts",
    "typecheck": "pnpm -r --if-present build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && forge test --root contracts",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "pilot": "pnpm --filter @euthyna/api pilot",
    "pilot:server": "pnpm --filter @euthyna/api pilot:server",
    "pilot:ui": "pnpm --stream --parallel --filter @euthyna/api --filter @euthyna/web pilot:dev"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
