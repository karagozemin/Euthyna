{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @euthyna/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/pilot-api/:path*",
      "destination": "https://euthyna.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
